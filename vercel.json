{
  "version": 2,
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/media/(.*)",
      "dest": "/media/$1"
    },
    {
      "src": "/developer/(.*)",
      "dest": "/developer/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ]
}
